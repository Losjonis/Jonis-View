{
  "name": "jonis-video-capture",
  "version": "0.3.0",
  "private": true,
  "description": "Visor de capturadoras USB para Windows",
  "author": "Jonis",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win portable",
    "store": "node scripts/store.cjs",
    "smoke": "node scripts/smoke.cjs",
    "test:clips": "node scripts/clips-check.cjs",
    "build:i18n": "node scripts/build-i18n.cjs",
    "test:languages": "node scripts/localization-check.cjs"
  },
  "build": {
    "appId": "com.jonis.videocapture",
    "productName": "Jonis View",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "appx": {
      "applicationId": "JonisView",
      "displayName": "Jonis View",
      "languages": [
        "es-ES",
        "en-US",
        "fr-FR",
        "de-DE",
        "sv-SE",
        "ru-RU"
      ],
      "backgroundColor": "#141116",
      "capabilities": [
        "webcam",
        "microphone"
      ],
      "minVersion": "10.0.19045.0",
      "maxVersionTested": "10.0.26200.0"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "license": "GPL-3.0-only"
}
